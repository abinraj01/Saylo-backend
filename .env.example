# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/saylo_db
# MongoDB Atlas (SRV format):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/saylo_db?retryWrites=true&w=majority
# MongoDB Atlas (Standard format for legacy / restricted DNS networks):
# MONGO_URI=mongodb://<username>:<password>@cluster0-shard-00-00.vsnys31.mongodb.net:27017,cluster0-shard-00-01.vsnys31.mongodb.net:27017,cluster0-shard-00-02.vsnys31.mongodb.net:27017/saylo_db?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority

# Security Secrets
COOKIE_SECRET=your_secure_cookie_secret_here
JWT_SECRET=your_secure_jwt_secret_here
